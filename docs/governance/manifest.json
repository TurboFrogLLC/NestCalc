{
  "schema_version": "nestcalc-governance-manifest-v1",
  "repository": "TurboFrogLLC/NestCalc",
  "mode_file": "docs/governance/MODE",
  "command": "python3 scripts/nestcalc-governance.py",
  "runtime_directory": ".nestcalc/governance",
  "contracts": {
    "goal_metadata": "docs/governance/schemas/goal-metadata.schema.json",
    "execution_handoff": "docs/governance/schemas/execution-handoff.schema.json",
    "closeout_disposition": "docs/governance/schemas/closeout-disposition.schema.json",
    "closeout_breakdown": "docs/governance/schemas/closeout-breakdown.schema.json",
    "post_merge_snapshot": "docs/governance/schemas/post-merge-snapshot.schema.json"
  },
  "required_paths": [
    "GOAL.md",
    "LESSONS_LEARNED.md",
    "docs/WORKFLOW.md",
    "docs/GLOSSARY.md",
    "docs/templates/traveler.md",
    "docs/templates/packet.md",
    "docs/templates/packslip.md",
    "docs/templates/nonconformance.md",
    "docs/templates/goal-form.md",
    "docs/governance/MODE",
    "docs/governance/README.md",
    "docs/governance/GAP-AND-HARDENING.md",
    "docs/governance/goal-lifecycle-contract.md",
    "docs/governance/closeout-rollback-templates.md",
    "docs/governance/pr-closeout-breakdown-disposition.md",
    "docs/governance/lesson-persistence-example.md",
    "scripts/nestcalc-governance.py",
    "test/governance/test_nestcalc_governance.py"
  ],
  "fixtures": {
    "valid": [
      "docs/governance/fixtures/valid/goal.md",
      "docs/governance/fixtures/valid/execution-handoff.json",
      "docs/governance/fixtures/valid/closeout-disposition.json",
      "docs/governance/fixtures/valid/closeout-blocked.json",
      "docs/governance/fixtures/valid/closeout-breakdown.md",
      "docs/governance/fixtures/valid/post-merge-snapshot.json"
    ],
    "invalid": [
      "docs/governance/fixtures/invalid/goal-multiple-active.md",
      "docs/governance/fixtures/invalid/goal-model-mismatch.md",
      "docs/governance/fixtures/invalid/execution-handoff-prompt-plaintext.json",
      "docs/governance/fixtures/invalid/closeout-draft-pr.json",
      "docs/governance/fixtures/invalid/closeout-breakdown-missing-disposition.md",
      "docs/governance/fixtures/invalid/post-merge-stale.json"
    ]
  }
}
