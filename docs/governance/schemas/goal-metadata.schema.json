{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurboFrogLLC/NestCalc/docs/governance/schemas/goal-metadata.schema.json",
  "title": "NestCalcGoalMetadataV1",
  "type": "object",
  "required": ["schema_version", "flow_id", "repository", "active_goal_title", "goal_sha256", "goal_memory_commit", "branch_intent", "execution_route", "publication_route", "skills", "protected_surfaces", "agent_roster"],
  "properties": {
    "schema_version": {"const": "nestcalc-goal-v1"},
    "flow_id": {"type": "string", "pattern": "^NC-[0-9]{8}-[0-9a-f]{8}$"},
    "repository": {"const": "TurboFrogLLC/NestCalc"},
    "active_goal_title": {"type": "string", "minLength": 1},
    "goal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "goal_memory_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch_intent": {"type": "string", "pattern": "^codex/[a-z0-9][a-z0-9._/-]*$"},
    "execution_route": {"const": "codex-cli"},
    "publication_route": {"const": "feature-pr"},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "protected_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "agent_roster": {
      "type": "object",
      "required": ["orchestrator", "read_only_agents"],
      "properties": {
        "orchestrator": {"const": "codex-cli"},
        "read_only_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lane", "requested_model", "observed_model", "status"],
            "properties": {
              "lane": {"type": "string", "minLength": 1},
              "requested_model": {"const": "gpt-5.4-mini"},
              "observed_model": {"type": ["string", "null"]},
              "status": {"enum": ["matched", "mismatch", "unavailable"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
