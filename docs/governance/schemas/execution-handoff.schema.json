{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurboFrogLLC/NestCalc/docs/governance/schemas/execution-handoff.schema.json",
  "title": "NestCalcExecutionHandoffV1",
  "type": "object",
  "required": ["schema_version", "flow_id", "repository", "goal_sha256", "goal_memory_commit", "branch_intent", "execution_route", "publication_route", "prompt_sha256", "agent_roster"],
  "properties": {
    "schema_version": {"const": "nestcalc-execution-handoff-v1"},
    "flow_id": {"type": "string", "pattern": "^NC-[0-9]{8}-[0-9a-f]{8}$"},
    "repository": {"const": "TurboFrogLLC/NestCalc"},
    "goal_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "goal_memory_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch_intent": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9_-])?(?:/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9_-])?)+$"},
    "execution_route": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]*$"},
    "publication_route": {"const": "feature-pr"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "agent_roster": {
      "type": "object",
      "required": ["orchestrator", "read_only_agents"],
      "properties": {
        "orchestrator": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]*$"},
        "read_only_agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lane", "requested_model", "observed_model", "status"],
            "properties": {
              "lane": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]*$"},
              "requested_model": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]*$"},
              "observed_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._+:/-]*$"},
              "status": {"enum": ["matched", "mismatch", "unavailable"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
