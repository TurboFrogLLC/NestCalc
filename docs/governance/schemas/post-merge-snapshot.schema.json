{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TurboFrogLLC/NestCalc/docs/governance/schemas/post-merge-snapshot.schema.json",
  "title": "NestCalcPostMergeSnapshotV1",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "captured_at", "repository", "branch", "branch_tip", "merged_pr", "main_sha", "working_tree", "pending_lessons"],
  "properties": {
    "schema_version": {"const": "nestcalc-post-merge-v1"},
    "snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "repository": {"const": "TurboFrogLLC/NestCalc"},
    "branch": {"type": "string", "pattern": "^codex/"},
    "branch_tip": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merged_pr": {"type": "object", "required": ["number", "url", "state"], "properties": {"number": {"type": "integer", "minimum": 1}, "url": {"type": "string"}, "state": {"const": "merged"}}, "additionalProperties": false},
    "main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_tree": {"type": "object", "required": ["clean", "status_sha256"], "properties": {"clean": {"type": "boolean"}, "status_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false},
    "pending_lessons": {"type": "object", "required": ["state", "lessons_sha256"], "properties": {"state": {"enum": ["none", "pending", "applied"]}, "lessons_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
