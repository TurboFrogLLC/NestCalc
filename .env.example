# Clerk authentication — copy to .env.local and fill in real values.
# Get keys from https://dashboard.clerk.com/ or run: clerk env pull

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Access request emails (Resend) — required for the Request Access form on /sign-in
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="NestCalc <notifications@yourdomain.com>"
ACCESS_REQUEST_ADMIN_EMAIL=admin@yourdomain.com

# Optional Playwright + Clerk authenticated E2E proof.
# Use Clerk test-mode keys and a non-production test user only.
CLERK_TESTING_TOKEN=your_optional_testing_token_here
E2E_CLERK_USER_EMAIL=your_name+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=your_test_user_password_here
